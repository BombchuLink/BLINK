#!/bin/sh

# Use neovim for vim if present.
command -v nvim >/dev/null && alias vim="nvim" vimdiff="nvim -d"

# Verbosity and settings that you pretty much just always are going to want.
alias \
	cp="cp -v" \
	mv="mv -iv" \
	rm="rm -v" \
	bat="cat /sys/class/power_supply/BAT?/capacity" \
	mkd="mkdir -pv" \
	8MB="$HOME/.config/scripts/8MB" \
	yt="yt-dlp --add-metadata -i" \
	ytd='yt-dlp -R infinite --restrict-filenames' \
	ytd480="yt-dlp -f 'bestaudio+bestvideo[height<=480]' " \
	yta="yt -x -f bestaudio/best --restrict-filenames" \
	ytv="ytd -f 'bestvideo[height<=1080]' --restrict-filenames" \
	ffmpeg="ffmpeg -hide_banner" \
	org="wine $HOME/drives/tco/Music/ORG/Org210x.exe" \
	#xdelta="xdelta3"

# Colorize commands when possible.
alias \
	ls="ls -hN --color=auto --group-directories-first" \
	grep="grep --color=auto" \
	diff="diff --color=auto" \
	ccat="highlight --out-format=ansi"

