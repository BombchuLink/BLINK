##############################################################################
## This is the example configuration file. Copy it to $HOME/.ncmpcpp/config ##
## or $XDG_CONFIG_HOME/ncmpcpp/config and set up your preferences.          ##
##############################################################################

ncmpcpp_directory = ~/.config/ncmpcpp
lyrics_directory = ~/.local/share/lyrics
mpd_music_dir = "~/drives/media/Music/1_LibraryMusic"
visualizer_type = spectrum
#visualizer_type = ellipse
#visualizer_type = wave
visualizer_color = red, green, yellow, blue, magenta, cyan, white
visualizer_look = "██"
message_delay_time = 1
seek_time = 3
#
##### song format #####
##
## For a song format you can use:
##
## %l - length
## %f - filename
## %D - directory
## %a - artist
## %A - album artist
## %t - title
## %b - album
## %y - date
## %n - track number (01/12 -> 01)
## %N - full track info (01/12 -> 01/12)
## %g - genre
## %c - composer
## %p - performer
## %d - disc
## %C - comment
## %P - priority
## $R - begin right alignment
##

song_list_format = {$4%a - }{%t}|{$8%f$9}$R{$3(%l)$9}
song_status_format = $b{{$6%t - }}{%a:{ %b{ (%y)}}}|{%f}
song_library_format = {%n - }{%t}|{%f}
alternative_header_first_line_format = $b$1$aqqu$/a$9 {%t}|{%f} $1$atqq$/a$9$/b
alternative_header_second_line_format = {{$4$b%a$/b$9}{ - $7%b$9}{ ($4%y$9)}}|{%D}
current_item_prefix = $(cyan)$r$b
current_item_suffix = $/r$(end)$/b
current_item_inactive_column_prefix = $(green)$r
current_item_inactive_column_suffix = $/r$(end)

song_columns_list_format = (40)[]{b} (6f)[green]{NE} (50)[white]{t|f:Title} (7f)[magenta]{l}
playlist_display_mode = columns
browser_display_mode = columns
progressbar_look = ___
media_library_primary_tag = album_artist
media_library_albums_split_by_date = no
startup_screen = media_library
display_volume_level = no
ignore_leading_the = yes
external_editor = nvim
use_console_editor = yes
locked_screen_width_part = 60

##### colors definitions #####
colors_enabled = yes
empty_tag_color = green
state_line_color = green
main_window_color = green
#main_window_highlight_color = blue
progressbar_color = cyan
progressbar_elapsed_color = blue
statusbar_color = red
statusbar_time_color = cyan:b
player_state_color = green

