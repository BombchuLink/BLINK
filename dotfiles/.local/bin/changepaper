#!/bin/bash

#call Dmenu to show wallpapers
resource=$( ls ~/.config/wallpaper | cut -c 6- | cut -f1 -d"."  | dmenu -i -l 30)

#make sure the png exist (makes Xreources if it doesn't)
if ls ~/.config/wallpaper | grep -q "$resource"; then

#remember default wallpaper
mv -f $HOME/.config/wall.png $HOME/.config/wallpaper/wall_Prev.png
cp -f $HOME/.config/wallpaper/wall_$resource.png $HOME/.config/wall.png &&
xwallpaper --zoom ~/.config/wall.png
if [[ ! -f $HOME/.config/Xassets/X$resource ]]; then
	notify-send "Initalizing $resource assets"
	cp -f $HOME/.config/Xassets/XDefault $HOME/.config/Xassets/X$resource
fi

#rewrite header file and put with colors
rm -f $HOME/.config/XResources
Notice=$( echo "!! THIS FILE WAS COMPILED USING ~/.local/bin/changepaper DO NOT EDIT THIS FILE DIRECTLY!")
Head=$( echo "$HOME/.config/Xassets/X_ASSET_Head")
Color=$( echo "$HOME/.config/Xassets/X$resource")
cat <<EOF > $HOME/.config/XResources;
$Notice

$(cat $HOME/.config/Xassets/X_ASSET_Head) 

$(cat $HOME/.config/Xassets/X$resource)
EOF

# extract colors 0 and 15 and add to end of file under dmenu and bspwm assets
Color0=$( grep '\*.color0:' $HOME/.config/Xassets/X$resource | awk '{print $2}' )
Color15=$( grep '\*.color15:' $HOME/.config/Xassets/X$resource | awk '{print $2}' )
Color3=$( grep '\*.color3:' $HOME/.config/Xassets/X$resource | awk '{print $2}' )
Color8=$( grep '\*.color8:' $HOME/.config/Xassets/X$resource | awk '{print $2}' )

# fun math to get xst background color
input_color=$( echo "$Color0");

# Convert hex to decimal
r=$(printf "%d" 0x${input_color:1:2})
g=$(printf "%d" 0x${input_color:3:2})
b=$(printf "%d" 0x${input_color:5:2})

decrease_value=0x10

r=$((r >= decrease_value ? r - decrease_value : 0))
g=$((g >= decrease_value ? g - decrease_value : 0))
b=$((b >= decrease_value ? b - decrease_value : 0))

#result_color=$(printf "#%02x%02x%02x" $r $g $b)

#hijacked by tokyomoon
result_color=$(printf "#222436" $r $g $b)

#printout
echo -e "\n" >> $HOME/.config/XResources
echo "!!Extracted Assets assignment" >> $HOME/.config/XResources
echo "dmenu.background:		$Color0" >> $HOME/.config/XResources
echo "dmenu.selbackground:	$Color15" >> $HOME/.config/XResources
echo "dmenu.foreground:		$Color15" >> $HOME/.config/XResources
echo -e "dmenu.selforeground:	$Color0\n" >> $HOME/.config/XResources
echo "st.background:			$result_color" >> $HOME/.config/XResources

xrdb $HOME/.config/XResources &&
pkill polybar;
pkill -x --signal USR1 xst;
pkill -USR1 -x sxhkd;
pkill dwm;

else
    notify-send "I'm sorry but that wallpaper png doesn't exist..." --icon="$HOME/.config/nannybot/icons/Betty/notify_thinking.png" -t 60000
fi
